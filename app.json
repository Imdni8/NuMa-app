{
  "expo": {
    "name": "NuMa",
    "slug": "NuMa-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "numaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Track child-care activities — feedings, burpings, nappy changes — at a tap.",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "NuMa",
      "shortName": "NuMa",
      "description": "Track child-care activities — feedings, burpings, nappy changes — at a tap.",
      "themeColor": "#7C5BC4",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
